# ==============================================================================
# NEXUS — AI-Native Business Operations Platform (.env.example)
# ==============================================================================

# --- Application Environment ---
APP_NAME=NEXUS
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database Configuration (PostgreSQL primary; SQLite fallback for isolated tests) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nexus_ops
FALLBACK_SQLITE_URL=sqlite:///./nexus_ops.db

# --- Redis & Background Task Queue (Celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Authentication & Security ---
JWT_SECRET_KEY=change-this-to-a-64-char-cryptographic-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# 32-byte URL-safe base64-encoded key for Fernet encryption at rest
ENCRYPTION_MASTER_KEY=change-this-to-a-valid-32-byte-base64-fernet-key-in-prod=

# --- AI & LLM Orchestration (OpenAI-Compatible Provider Abstraction) ---
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
MAX_TOOL_INVOCATIONS_PER_RUN=10
TOOL_EXECUTION_TIMEOUT_SECONDS=30

# --- MCP Server Shared Authentication ---
MCP_INTERNAL_AUTH_TOKEN=change-this-internal-mcp-hmac-token-in-production

# --- OpenTelemetry & Observability ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=nexus-ops-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=NEXUS

